# Copia este archivo como .env y completa los valores. El .env no se sube a git.
# Genera valores aleatorios, por ejemplo: openssl rand -base64 48
POSTGRES_PASSWORD=
MONGO_PASSWORD=
# Clave para firmar los JWT: mínimo 32 caracteres aleatorios.
JWT_SECRET_KEY=

# ---- Producción (docker-compose.prod.yml), en un archivo .env.prod aparte ----
# POSTGRES_OWNER_PASSWORD=   # dueño del esquema (solo para migraciones)
# POSTGRES_APP_PASSWORD=     # usuario ate_app con mínimo privilegio
# MONGO_ROOT_PASSWORD=
# MONGO_APP_PASSWORD=
# JWT_SECRET_KEY=            # openssl rand -base64 48
# API_ALLOWED_HOSTS=api.ate.com
# FRONTEND_ORIGIN=https://app.ate.com
# SMTP_PASSWORD=
# PROXY_NETWORK=172.16.0.0/12
