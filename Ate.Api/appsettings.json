{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/ate-api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "Ate.Api"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=ate_db;Username=postgres;Password=postgres",
    "MongoDbConnection": "mongodb://ate_admin:ate_mongo_2026@localhost:27017/?authSource=admin"
  },
  "MongoDbSettings": {
    "ConnectionString": "mongodb://ate_admin:ate_mongo_2026@localhost:27017/?authSource=admin",
    "DatabaseName": "ate_nosql_db"
  },
  "JwtSettings": {
    "SecretKey": "CLAVE_SECRET_POR_DEFECTO_REEMPLAZAR_EN_USER_SECRETS_O_ENV_VARS",
    "Issuer": "Ate.Api",
    "Audience": "Ate.Client",
    "ExpirationInMinutes": 480
  },
  "SmtpSettings": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "UserName": "ga99buggi@gmail.com",
    "Password": "",
    "SenderEmail": "ga99buggi@gmail.com",
    "SenderName": "Ate Platform",
    "EnableSsl": true,
    "SupportEmail": "ga99buggi@gmail.com",
    "DefaultCcEmail": null
  }
}
