{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/ate-api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ],
    "Properties": {
      "Application": "Ate.Api"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "",
    "MongoDbConnection": ""
  },
  "MongoDbSettings": {
    "ConnectionString": "",
    "DatabaseName": "ate_nosql_db"
  },
  "JwtSettings": {
    "SecretKey": "",
    "Issuer": "Ate.Api",
    "Audience": "Ate.Client",
    "ExpirationInMinutes": 480
  },
  "PasswordRecovery": {
    "CodeLifetimeMinutes": 10,
    "ResetTokenLifetimeMinutes": 10,
    "MaxAttempts": 5,
    "ResendCooldownSeconds": 30,
    "MaxCodesPerHour": 5
  },
  "LoginThrottling": {
    "MaxFailuresPerDocumentAndIp": 5,
    "MaxFailuresPerDocument": 20,
    "WindowMinutes": 15,
    "MaxRequestsPerIpPerMinute": 30
  },
  "SmtpSettings": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "UserName": "ga99buggi@gmail.com",
    "Password": "",
    "SenderEmail": "ga99buggi@gmail.com",
    "SenderName": "Ate Platform",
    "EnableSsl": true,
    "SupportEmail": "ga99buggi@gmail.com",
    "DefaultCcEmail": null
  }
}
